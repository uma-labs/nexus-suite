//@version=5
// NEXUS Radar Pro — validated winners only. Not financial advice.
// Liquid (1H): HYBRID >=2 of {EMA reclaim, RSI50 cross, VWAP reclaim}
// Book Auto/Book (1D): EMA stack pullback reclaim. Book on 1H: no entry.
indicator("NEXUS Radar Pro", shorttitle="NEXUS Pro", overlay=true, max_lines_count=200, max_labels_count=200)

mode        = input.string("Auto", "Mode", options=["Liquid", "Book", "Auto"])
confirmBar  = input.bool(true, "Require bar close (anti-repaint)")
atrLen      = input.int(14, "ATR Length", minval=1)
stopATR     = input.float(1.2, "Stop ATR")
tpATR       = input.float(2.5, "TP ATR")
trailATR    = input.float(2.0, "Trail ATR")
maxBars     = input.int(12, "Max Bars", minval=1)
minRVOL     = input.float(1.0, "Min RVOL")
minATRpct   = input.float(0.8, "Min ATR %")
minDollarLiq= input.float(5.0, "Min $Vol M (Liquid)")
minDollarBk = input.float(0.5, "Min $Vol M (Book)")
bookList    = input.string("SPCX,RKLB,ASTS", "Book tickers (Auto)")
showEMAs    = input.bool(true, "Show EMAs / VWAP")
showLevels  = input.bool(true, "Show trade levels")
showDash    = input.bool(true, "Show dashboard")

ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema55 = ta.ema(close, 55)
atr   = ta.atr(atrLen)
volSma = ta.sma(volume, 20)
rvol = volSma > 0 ? volume / volSma : 0.0
atrpct = close > 0 ? atr / close * 100.0 : 0.0
dollarVolM = volSma * close / 1e6
rsi = ta.rsi(close, 14)
vwapProxy = ta.vwap(hlc3)

tkr = str.upper(syminfo.ticker)
isBookSym = str.contains(str.upper(bookList), tkr)
useBookLiq = mode == "Book" or (mode == "Auto" and isBookSym)
minDollar = useBookLiq ? minDollarBk : minDollarLiq
softLiq = rvol >= minRVOL and atrpct >= minATRpct and dollarVolM >= minDollar

L_RSI50 = ema21 > ema55 and ta.crossover(rsi, 50) and rvol >= 1.0

stack = ema9 > ema21 and ema21 > ema55
pullback = false
for i = 0 to 5
    pullback := pullback or (low[i] <= ema21[i] + 0.5 * atr[i])
L_EMA_RECLAIM = stack and pullback and ta.crossover(close, ema9)

L_VWAP_RECLAIM = ta.crossover(close, vwapProxy) and rvol >= 1.2 and close > ema21

votes = (L_EMA_RECLAIM ? 1 : 0) + (L_RSI50 ? 1 : 0) + (L_VWAP_RECLAIM ? 1 : 0)
HYBRID = votes >= 2

effBook = mode == "Book" or (mode == "Auto" and isBookSym)
longLiquid = softLiq and HYBRID
longBook = softLiq and timeframe.isdaily and L_EMA_RECLAIM
rawLong = effBook ? longBook : longLiquid
barOk = not confirmBar or barstate.isconfirmed
longSignal = rawLong and barOk and (effBook or timeframe.isintraday)

var int pos = 0
var float entryPx = na
var float stopPx = na
var float tpPx = na
var float extreme = na
var int entryBar = na
var line lnEntry = na
var line lnStop = na
var line lnTp = na

exitNow = false
if barOk
    if pos == 0 and longSignal
        pos := 1
        entryPx := close
        stopPx := close - stopATR * atr
        tpPx := close + tpATR * atr
        extreme := high
        entryBar := bar_index
        if showLevels
            if not na(lnEntry)
                line.delete(lnEntry)
            if not na(lnStop)
                line.delete(lnStop)
            if not na(lnTp)
                line.delete(lnTp)
            lnEntry := line.new(bar_index, entryPx, bar_index + 8, entryPx, color=color.aqua, width=2)
            lnStop := line.new(bar_index, stopPx, bar_index + 8, stopPx, color=color.red, style=line.style_dashed, width=2)
            lnTp := line.new(bar_index, tpPx, bar_index + 8, tpPx, color=color.lime, style=line.style_dotted, width=2)
    else if pos == 1
        extreme := math.max(nz(extreme, high), high)
        trail = extreme - trailATR * atr
        curStop = math.max(stopPx, trail)
        barsHeld = bar_index - entryBar
        if low <= curStop or high >= tpPx or barsHeld >= maxBars
            pos := 0
            exitNow := true
            if not na(lnEntry)
                line.delete(lnEntry)
            if not na(lnStop)
                line.delete(lnStop)
            if not na(lnTp)
                line.delete(lnTp)
        else if showLevels and not na(lnStop)
            line.set_xy2(lnStop, bar_index + 5, curStop)
            line.set_xy2(lnEntry, bar_index + 5, entryPx)
            line.set_xy2(lnTp, bar_index + 5, tpPx)

newLong = barOk and longSignal and pos == 1 and longSignal
// entry mark: transition into position
entered = barOk and pos == 1 and pos[1] == 0
exited = exitNow

plot(showEMAs ? ema9 : na, "EMA9", color=color.new(#00E5FF, 0))
plot(showEMAs ? ema21 : na, "EMA21", color=color.new(#FFD54F, 0), linewidth=2)
plot(showEMAs ? ema55 : na, "EMA55", color=color.new(#FF4081, 30), linewidth=2)
plot(showEMAs ? vwapProxy : na, "VWAP", color=color.new(#FFEB3B, 20), linewidth=2)

plotshape(entered, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=color.new(#00E676, 0), size=size.small, text="PRO")
plotshape(exited, title="Exit", style=shape.xcross, location=location.abovebar, color=color.new(#FFAB40, 0), size=size.tiny, text="OUT")
bgcolor(softLiq ? color.new(#00E676, 92) : na)

activeRule = effBook ? (timeframe.isdaily ? "EMA_RECLAIM" : "WAIT_1D") : "HYBRID"
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(#05070d, 15), border_width=1, border_color=color.new(#00E5FF, 60))
if showDash and barstate.islast
    table.cell(dash, 0, 0, "NEXUS Pro", text_color=color.aqua, text_size=size.small)
    table.cell(dash, 1, 0, mode, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "Rule", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, activeRule, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Liq", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, softLiq ? "PASS" : "FAIL", text_color=softLiq ? color.lime : color.red, text_size=size.small)
    table.cell(dash, 0, 3, "Votes", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(votes), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Pos", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, pos == 1 ? "LONG" : "FLAT", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 5, "RVOL", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(rvol, "#.00"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "ATR%", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(atrpct, "#.00"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "$VolM", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(dollarVolM, "#.1"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 8, "Book", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, isBookSym ? "YES" : "no", text_color=isBookSym ? color.yellow : color.gray, text_size=size.small)

plot(longSignal ? 1 : 0, "Long Setup", display=display.data_window)
plot(pos == 1 ? 1 : 0, "In Long", display=display.data_window)
plot(votes * 33.0, "Score", display=display.data_window)
plot(rvol, "Rel Volume", display=display.data_window)
plot(atrpct, "ATR %", display=display.data_window)

alertcondition(entered, title="NEXUS Pro Long", message="NEXUS Pro LONG {{ticker}} @ {{close}}")
alertcondition(exited, title="NEXUS Pro Exit", message="NEXUS Pro EXIT {{ticker}} @ {{close}}")
