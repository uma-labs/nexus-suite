// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © NEXUS Radar v2 — signals only, not financial advice
//
// APPROXIMATIONS / ASSUMPTIONS (see README_v2.md):
 // 1. RTH / ORB times use `time()` in the *chart symbol's exchange timezone*
 //    (US equities ≈ America/New_York). Documented; not a hard-coded NY tz API.
 // 2. ORB (first 2×1H bars after 0930) is fully enabled when timeframe.period=="60".
 //    On other TFs, ORB is gated off (signal B never fires) to avoid mis-counting.
 // 3. "Pullback touch ≥1 bar then reclaim" uses a stateful touch flag reset on
 //    directional close through EMA21.
 // 4. Book soft score is a ticker-id string match vs a fixed watchlist (not options flow).

//@version=5
indicator("NEXUS Radar v2 · Entry/Exit + Scan", shorttitle="NEXUS v2", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// ═══════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════
grpHTF = "A · HTF Bias / Pullback"
htfTF       = input.timeframe("240", "HTF timeframe (4H)", group=grpHTF)
emaHtfFast  = input.int(20, "HTF EMA fast", minval=2, group=grpHTF)
emaHtfSlow  = input.int(50, "HTF EMA slow", minval=2, group=grpHTF)
ema21Len    = input.int(21, "EMA21 (pullback / trail)", minval=2, group=grpHTF)
pbEmaAtr    = input.float(0.15, "Pullback EMA band (×ATR)", step=0.05, group=grpHTF)
pbVwapAtr   = input.float(0.25, "Pullback VWAP band (×ATR)", step=0.05, group=grpHTF)

grpORB = "B · Opening Range Breakout"
rthSession  = input.session("0930-1600", "RTH session (exchange tz)", group=grpORB)
orbStartH   = input.int(9, "OR window start hour", minval=0, maxval=23, group=grpORB)
orbStartM   = input.int(30, "OR window start minute", minval=0, maxval=59, group=grpORB)
orbBars     = input.int(2, "OR bars (1H bars after open)", minval=1, maxval=4, group=grpORB)
orbArmH     = input.int(11, "ORB arm hour (ET)", minval=0, maxval=23, group=grpORB)
orbArmM     = input.int(30, "ORB arm minute", minval=0, maxval=59, group=grpORB)
orbInvAtr   = input.float(0.5, "ORB invalidate inside OR (×ATR)", step=0.1, group=grpORB)
enableORB   = input.bool(true, "Enable ORB family (requires 1H chart)", group=grpORB)

grpVWAP = "C · VWAP Reclaim"
vwapBelowBars = input.int(2, "Min closes below VWAP before reclaim", minval=1, group=grpVWAP)
vwapVolMult   = input.float(1.2, "Reclaim volume ≥ × SMA(vol)", step=0.1, group=grpVWAP)
vwapMaxDist   = input.float(1.5, "Skip if |close−VWAP|/ATR >", step=0.1, group=grpVWAP)

grpComp = "D · Compression → Expansion"
bbLen       = input.int(20, "BB length", minval=5, group=grpComp)
bbMult      = input.float(2.0, "BB mult", step=0.1, group=grpComp)
compLookback= input.int(20, "Compression lookback", minval=5, group=grpComp)
compRvol    = input.float(1.5, "Expansion RVOL ≥", step=0.1, group=grpComp)

grpFilt = "Hard Filters"
dollarTier  = input.string("Active", "Dollar-volume tier", options=["Active", "A-tier"], group=grpFilt,
     tooltip="Active = $50M default. A-tier = $100M for mega-liquid names.")
dollarMinIn = input.float(50.0, "Active $ vol floor (millions)", step=5.0, group=grpFilt)
dollarATier = input.float(100.0, "A-tier $ vol floor (millions)", step=5.0, group=grpFilt)
minRvol     = input.float(1.2, "Min RVOL (A/C)", step=0.1, group=grpFilt)
minRvolStrict = input.float(1.5, "Min RVOL (ORB / compression)", step=0.1, group=grpFilt)
atrPctLo    = input.float(1.5, "ATR% min", step=0.1, group=grpFilt)
atrPctHi    = input.float(8.0, "ATR% max", step=0.1, group=grpFilt)
rthEndH     = input.int(15, "RTH end hour", minval=0, maxval=23, group=grpFilt)
rthEndM     = input.int(55, "RTH end minute", minval=0, maxval=59, group=grpFilt)

grpExit = "Exits"
stopStructAtr = input.float(0.25, "Stop: signal extreme − ×ATR", step=0.05, group=grpExit)
stopCapAtr    = input.float(1.0, "Stop: entry − ×ATR (cap)", step=0.1, group=grpExit)
tp1Atr        = input.float(1.5, "TP1 ×ATR", step=0.1, group=grpExit)
timeStopBars  = input.int(6, "Time stop (bars)", minval=1, group=grpExit)

grpShow = "Display / Alerts"
tradeMode   = input.string("Both", "Trade mode", options=["Both", "Long only", "Short only"], group=grpShow)
showEMAs    = input.bool(true, "Show EMAs + VWAP", group=grpShow)
showOR      = input.bool(true, "Show today's OR box", group=grpShow)
showSignals = input.bool(true, "Show entry/exit marks", group=grpShow)
showLevels  = input.bool(true, "Show active trade levels", group=grpShow)
showDash    = input.bool(true, "Show dashboard", group=grpShow)
confirmBar  = input.bool(true, "Require bar close (anti-repaint)", group=grpShow)

// ═══════════════════════════════════════════════════════════
// CORE SERIES
// ═══════════════════════════════════════════════════════════
atr14   = ta.atr(14)
atrPct  = close > 0 ? atr14 / close * 100.0 : 0.0
volSma20= ta.sma(volume, 20)
rvol    = volSma20 > 0 ? volume / volSma20 : 0.0
dollarVol = ta.sma(close * volume, 20)
dollarNeed = (dollarTier == "A-tier" ? dollarATier : dollarMinIn) * 1e6
dollarOk = dollarVol >= dollarNeed

ema21 = ta.ema(close, ema21Len)
vwapVal = ta.vwap(hlc3)

[bbMid, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)
bbWidth = bbUpper - bbLower
atrPctSeries = close > 0 ? atr14 / close : 0.0

// HTF 4H bias: long if close>EMA50 AND EMA20>EMA50; short flip; else flat
f_htfBias() =>
    e20 = ta.ema(close, emaHtfFast)
    e50 = ta.ema(close, emaHtfSlow)
    c = close
    bias = c > e50 and e20 > e50 ? 1 : c < e50 and e20 < e50 ? -1 : 0
    bias

htfBias = request.security(syminfo.tickerid, htfTF, f_htfBias(), barmerge.gaps_off, barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════
// SESSION / RTH (exchange timezone via time())
// Assumption: for US equities, exchange tz ≈ America/New_York.
// ═══════════════════════════════════════════════════════════
inSession = not na(time(timeframe.period, rthSession))
exH = hour(time)
exM = minute(time)
minsOfDay = exH * 60 + exM
rthStartMins = orbStartH * 60 + orbStartM
rthEndMins   = rthEndH * 60 + rthEndM
inRTH = inSession and minsOfDay >= rthStartMins and minsOfDay <= rthEndMins

barOk = not confirmBar or barstate.isconfirmed
allowLong  = tradeMode != "Short only"
allowShort = tradeMode != "Long only"

// Book soft score — fixed watchlist flag
tkr = str.upper(syminfo.ticker)
bookFlag = tkr == "SPCX" or tkr == "RKLB" or tkr == "ASTS" or tkr == "NVDA" or tkr == "MU" or tkr == "META" or tkr == "AMD" or tkr == "TSLA"

// Hard filter base (RVOL threshold applied per-family)
atrOk = atrPct >= atrPctLo and atrPct <= atrPctHi
hardBase = dollarOk and atrOk and inRTH

// ═══════════════════════════════════════════════════════════
// FAMILY A — HTF bias + pullback into EMA21 / VWAP → reclaim
// ═══════════════════════════════════════════════════════════
emaBand = pbEmaAtr * atr14
vwapBand = pbVwapAtr * atr14
touchEmaLong  = low <= ema21 + emaBand and low >= ema21 - emaBand
touchEmaShort = high >= ema21 - emaBand and high <= ema21 + emaBand
touchVwapLong  = low <= vwapVal + vwapBand and low >= vwapVal - vwapBand
touchVwapShort = high >= vwapVal - vwapBand and high <= vwapVal + vwapBand

var bool touchedLongZone  = false
var bool touchedShortZone = false
if htfBias == 1 and (touchEmaLong or touchVwapLong)
    touchedLongZone := true
if htfBias == -1 and (touchEmaShort or touchVwapShort)
    touchedShortZone := true
if htfBias != 1
    touchedLongZone := false
if htfBias != -1
    touchedShortZone := false
// Reset after directional reclaim fires (handled below via entry)

// Require zone touch on a prior bar, then directional close back through EMA21
reclaimLongA  = touchedLongZone[1] and close > ema21 and close > close[1]
reclaimShortA = touchedShortZone[1] and close < ema21 and close < close[1]

filtA_long  = hardBase and rvol >= minRvol and htfBias == 1
filtA_short = hardBase and rvol >= minRvol and htfBias == -1

sigA_long  = allowLong  and filtA_long  and reclaimLongA  and barOk
sigA_short = allowShort and filtA_short and reclaimShortA and barOk

// ═══════════════════════════════════════════════════════════
// FAMILY B — ORB (1H chart only)
// First `orbBars` 1H bars after 0930 define OR high/low.
// After 1130 only: long close>OR high AND close>VWAP; short mirror.
// Invalidate if close back inside OR by >0.5ATR from the break edge.
// ═══════════════════════════════════════════════════════════
is1H = timeframe.period == "60"
orbEnabled = enableORB and is1H

var float orHigh = na
var float orLow  = na
var int   orBarsCounted = 0
var int   orDayId = na
var bool  orComplete = false
var bool  orbLongLive = false
var bool  orbShortLive = false
var int   orStartBar = na

dayId = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
newDay = na(orDayId) or dayId != orDayId

if newDay
    orDayId := dayId
    orHigh := na
    orLow := na
    orBarsCounted := 0
    orComplete := false
    orbLongLive := false
    orbShortLive := false
    orStartBar := na

// Count first N 1H bars at/after 0930 that are in session
inOrWindow = orbEnabled and inSession and minsOfDay >= rthStartMins and not orComplete
if inOrWindow and barstate.isconfirmed
    if orBarsCounted == 0
        orHigh := high
        orLow := low
        orStartBar := bar_index
        orBarsCounted := 1
    else if orBarsCounted < orbBars
        orHigh := math.max(nz(orHigh, high), high)
        orLow := math.min(nz(orLow, low), low)
        orBarsCounted += 1
    if orBarsCounted >= orbBars
        orComplete := true

orbArmed = orbEnabled and orComplete and minsOfDay >= (orbArmH * 60 + orbArmM) and inRTH

// Breakout triggers
orbBreakLong  = orbArmed and close > orHigh and close > vwapVal and rvol >= minRvolStrict
orbBreakShort = orbArmed and close < orLow  and close < vwapVal and rvol >= minRvolStrict

if orbBreakLong and barOk and hardBase and (htfBias == 1)
    orbLongLive := true
    orbShortLive := false
if orbBreakShort and barOk and hardBase and (htfBias == -1)
    orbShortLive := true
    orbLongLive := false

// Invalidate: close back inside OR by >0.5ATR
if orbLongLive and not na(orHigh) and close < orHigh and (orHigh - close) > orbInvAtr * atr14
    orbLongLive := false
if orbShortLive and not na(orLow) and close > orLow and (close - orLow) > orbInvAtr * atr14
    orbShortLive := false

filtB = hardBase and rvol >= minRvolStrict
sigB_long  = allowLong  and filtB and htfBias == 1  and orbBreakLong  and barOk
sigB_short = allowShort and filtB and htfBias == -1 and orbBreakShort and barOk

// ═══════════════════════════════════════════════════════════
// FAMILY C — VWAP reclaim
// ≥2 closes below VWAP then cross above with vol≥1.2*SMA;
// skip if |close-VWAP|/ATR > 1.5; may fire on flat HTF bias (not counter).
// ═══════════════════════════════════════════════════════════
belowVwap = close < vwapVal
aboveVwap = close > vwapVal
consecBelow = belowVwap and belowVwap[1]  // ≥2 closes below (current+prior); extend via counter

var int belowCount = 0
if belowVwap
    belowCount += 1
else
    belowCount := 0

var int aboveCount = 0
if aboveVwap
    aboveCount += 1
else
    aboveCount := 0

crossUpVwap = ta.crossover(close, vwapVal)
crossDnVwap = ta.crossunder(close, vwapVal)
distVwapAtr = atr14 > 0 ? math.abs(close - vwapVal) / atr14 : 999.0
volOkC = volume >= vwapVolMult * volSma20
distOkC = distVwapAtr <= vwapMaxDist

// Long reclaim: had ≥2 closes below, then cross above
readyLongC  = belowCount[1] >= vwapBelowBars and crossUpVwap
readyShortC = aboveCount[1] >= vwapBelowBars and crossDnVwap

biasOkC_long  = htfBias == 1 or htfBias == 0   // flat ok, not counter
biasOkC_short = htfBias == -1 or htfBias == 0

filtC = hardBase and rvol >= minRvol and distOkC and volOkC
sigC_long  = allowLong  and filtC and biasOkC_long  and readyLongC  and barOk
sigC_short = allowShort and filtC and biasOkC_short and readyShortC and barOk

// ═══════════════════════════════════════════════════════════
// FAMILY D — Compression → expansion
// BB width at 20-bar low OR ATR%/close in lowest 20% of 20 bars;
// then close outside BB + RVOL≥1.5; direction must match HTF bias.
// ═══════════════════════════════════════════════════════════
bbWidthLowest = bbWidth == ta.lowest(bbWidth, compLookback)
atrPctRank = ta.percentrank(atrPctSeries, compLookback)
atrCompressed = atrPctRank <= 20.0
compressed = bbWidthLowest or atrCompressed

expandLong  = compressed[1] and close > bbUpper and rvol >= compRvol
expandShort = compressed[1] and close < bbLower and rvol >= compRvol

filtD = hardBase and rvol >= minRvolStrict
sigD_long  = allowLong  and filtD and htfBias == 1  and expandLong  and barOk
sigD_short = allowShort and filtD and htfBias == -1 and expandShort and barOk

// ═══════════════════════════════════════════════════════════
// COMBINED ENTRIES (priority A > B > C > D for tagging)
// ═══════════════════════════════════════════════════════════
anyLong  = sigA_long  or sigB_long  or sigC_long  or sigD_long
anyShort = sigA_short or sigB_short or sigC_short or sigD_short

f_signalType(isLong) =>
    t = "—"
    if isLong
        t := sigA_long ? "A" : sigB_long ? "B" : sigC_long ? "C" : sigD_long ? "D" : "—"
    else
        t := sigA_short ? "A" : sigB_short ? "B" : sigC_short ? "C" : sigD_short ? "D" : "—"
    t

// Soft score 0–100
biasScore = htfBias != 0 ? 30 : 10
rvolScore = math.min(25, rvol * 10)
atrScore  = atrOk ? 15 : 0
dolScore  = dollarOk ? 15 : 0
bookScore = bookFlag ? 10 : 0
setupBonus = anyLong or anyShort ? 5 : 0
score = math.min(100, biasScore + rvolScore + atrScore + dolScore + bookScore + setupBonus)

scanPass = hardBase and rvol >= minRvol and (htfBias != 0 or anyLong or anyShort)
longSetup  = anyLong
shortSetup = anyShort

// Reset pullback touch after A fires
if sigA_long
    touchedLongZone := false
if sigA_short
    touchedShortZone := false

// ═══════════════════════════════════════════════════════════
// TRADE STATE / EXITS
// Stop long: max(signalLow - 0.25ATR, entry - 1.0ATR) wait —
// "min distance" of (signal low - 0.25ATR) vs (entry - 1.0ATR) = tighter = higher stop
// i.e. stop = max(sigLow - 0.25ATR, entry - 1.0ATR) for long (closer to price).
// ═══════════════════════════════════════════════════════════
var int    posDir = 0
var float  entryPx = na
var float  stopPx = na
var float  tp1Px = na
var float  signalExt = na
var bool   tp1Hit = false
var int    entryBar = na
var string entryType = "—"
var line   lnStop = na
var line   lnTp1 = na
var line   lnEntry = na
var line   lnTrail = na

f_clearLevels() =>
    if not na(lnStop)
        line.delete(lnStop)
    if not na(lnTp1)
        line.delete(lnTp1)
    if not na(lnEntry)
        line.delete(lnEntry)
    if not na(lnTrail)
        line.delete(lnTrail)

// Entry
newLong  = anyLong  and posDir <= 0 and not anyShort
newShort = anyShort and posDir >= 0 and not newLong

if newLong
    posDir := 1
    entryPx := close
    signalExt := low
    // tighter stop = higher price = max of the two candidates
    stopStruct = signalExt - stopStructAtr * atr14
    stopCap    = entryPx - stopCapAtr * atr14
    stopPx := math.max(stopStruct, stopCap)
    tp1Px := entryPx + tp1Atr * atr14
    tp1Hit := false
    entryBar := bar_index
    entryType := f_signalType(true)
    if showLevels
        f_clearLevels()
        lnEntry := line.new(bar_index, entryPx, bar_index + 20, entryPx, color=color.aqua, width=2)
        lnStop  := line.new(bar_index, stopPx, bar_index + 20, stopPx, color=color.red, width=2, style=line.style_dashed)
        lnTp1   := line.new(bar_index, tp1Px, bar_index + 20, tp1Px, color=color.lime, width=1, style=line.style_dotted)

if newShort
    posDir := -1
    entryPx := close
    signalExt := high
    stopStruct = signalExt + stopStructAtr * atr14
    stopCap    = entryPx + stopCapAtr * atr14
    stopPx := math.min(stopStruct, stopCap)  // tighter = lower stop for short
    tp1Px := entryPx - tp1Atr * atr14
    tp1Hit := false
    entryBar := bar_index
    entryType := f_signalType(false)
    if showLevels
        f_clearLevels()
        lnEntry := line.new(bar_index, entryPx, bar_index + 20, entryPx, color=color.aqua, width=2)
        lnStop  := line.new(bar_index, stopPx, bar_index + 20, stopPx, color=color.red, width=2, style=line.style_dashed)
        lnTp1   := line.new(bar_index, tp1Px, bar_index + 20, tp1Px, color=color.lime, width=1, style=line.style_dotted)

// Manage open trade — update TP1 hit, then evaluate exits as series (no := on non-var)
manageLong  = posDir == 1 and not newLong
manageShort = posDir == -1 and not newShort

if manageLong and not tp1Hit and not na(tp1Px) and high >= tp1Px
    tp1Hit := true
if manageShort and not tp1Hit and not na(tp1Px) and low <= tp1Px
    tp1Hit := true

exitLong = manageLong and not na(stopPx) and (
     (tp1Hit and close < ema21 and barOk) or
     (low <= stopPx) or
     (bar_index - nz(entryBar, bar_index) >= timeStopBars) or
     (htfBias == -1))

exitShort = manageShort and not na(stopPx) and (
     (tp1Hit and close > ema21 and barOk) or
     (high >= stopPx) or
     (bar_index - nz(entryBar, bar_index) >= timeStopBars) or
     (htfBias == 1))

if exitLong or exitShort
    posDir := 0
    if showLevels
        f_clearLevels()
    entryPx := na
    stopPx := na
    tp1Px := na
    tp1Hit := false
    entryType := "—"

// Extend level lines
if showLevels and posDir != 0 and not na(lnEntry)
    line.set_x2(lnEntry, bar_index + 2)
    line.set_x2(lnStop, bar_index + 2)
    line.set_x2(lnTp1, bar_index + 2)

// ═══════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════
plot(showEMAs ? ema21 : na, "EMA21", color=color.new(color.orange, 0), linewidth=2)
ema20_1h = ta.ema(close, 20)
ema50_1h = ta.ema(close, 50)
plot(showEMAs ? ema20_1h : na, "EMA20", color=color.new(color.aqua, 30), linewidth=1)
plot(showEMAs ? ema50_1h : na, "EMA50", color=color.new(color.fuchsia, 30), linewidth=1)
plot(showEMAs ? vwapVal : na, "VWAP", color=color.new(color.yellow, 0), linewidth=2)

// OR box for today
var box orBox = na
if showOR and orComplete and not na(orHigh) and not na(orLow)
    if na(orBox) or newDay
        if not na(orBox)
            box.delete(orBox)
        orBox := box.new(orStartBar, orHigh, bar_index, orLow,
             border_color=color.new(color.blue, 40), bgcolor=color.new(color.blue, 90),
             border_width=1)
    else
        box.set_right(orBox, math.max(bar_index, orStartBar + 1))
        box.set_top(orBox, orHigh)
        box.set_bottom(orBox, orLow)

// Entry shapes tagged A/B/C/D
plotshape(showSignals and sigA_long,  title="A Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0),   size=size.small, text="A")
plotshape(showSignals and sigA_short, title="A Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small, text="A")
plotshape(showSignals and sigB_long,  title="B Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.teal, 0),   size=size.small, text="B")
plotshape(showSignals and sigB_short, title="B Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.maroon, 0), size=size.small, text="B")
plotshape(showSignals and sigC_long,  title="C Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.aqua, 0),   size=size.small, text="C")
plotshape(showSignals and sigC_short, title="C Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.small, text="C")
plotshape(showSignals and sigD_long,  title="D Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0),  size=size.small, text="D")
plotshape(showSignals and sigD_short, title="D Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.purple, 0), size=size.small, text="D")

plotshape(showSignals and (exitLong or exitShort) ? close : na, title="Exit", style=shape.xcross, location=location.absolute,
     color=color.new(color.orange, 0), size=size.tiny, text="X")

// ═══════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 20), border_width=1)

if showDash and barstate.islast
    biasTxt = htfBias == 1 ? "LONG" : htfBias == -1 ? "SHORT" : "FLAT"
    biasCol = htfBias == 1 ? color.lime : htfBias == -1 ? color.red : color.gray
    sideTxt = posDir == 1 ? "LONG" : posDir == -1 ? "SHORT" : "FLAT"
    sigTxt  = posDir != 0 ? entryType : (anyLong ? f_signalType(true) : anyShort ? f_signalType(false) : "—")
    table.cell(dash, 0, 0, "NEXUS v2", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, dollarTier, text_color=color.aqua, text_size=size.small)
    table.cell(dash, 0, 1, "signal_type", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, sigTxt, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "side", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, sideTxt, text_color=posDir == 1 ? color.lime : posDir == -1 ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 3, "RVOL", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(rvol, "#.##"), text_color=rvol >= 1.2 ? color.lime : color.white, text_size=size.small)
    table.cell(dash, 0, 4, "ATR%", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(atrPct, "#.##"), text_color=atrOk ? color.lime : color.red, text_size=size.small)
    table.cell(dash, 0, 5, "4H_bias", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, biasTxt, text_color=biasCol, text_size=size.small)
    table.cell(dash, 0, 6, "dist_VWAP_ATR", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(distVwapAtr, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "book_flag", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, bookFlag ? "YES" : "no", text_color=bookFlag ? color.yellow : color.gray, text_size=size.small)
    table.cell(dash, 0, 8, "score", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, str.tostring(score, "#"), text_color=color.aqua, text_size=size.small)
    table.cell(dash, 0, 9, "ORB/1H", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, orbEnabled ? (orComplete ? "OR ready" : "building") : "gate 1H", text_color=orbEnabled ? color.teal : color.gray, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════
// SCREENER PLOTS (hide on chart; visible as screener columns)
// ═══════════════════════════════════════════════════════════
plot(scanPass ? 1 : 0, "Scan Pass", display=display.none)
plot(longSetup ? 1 : 0, "Long Setup", display=display.none)
plot(shortSetup ? 1 : 0, "Short Setup", display=display.none)
plot(sigA_long or sigA_short ? 1 : 0, "Signal A", display=display.none)
plot(sigB_long or sigB_short ? 1 : 0, "Signal B", display=display.none)
plot(sigC_long or sigC_short ? 1 : 0, "Signal C", display=display.none)
plot(sigD_long or sigD_short ? 1 : 0, "Signal D", display=display.none)
plot(score, "Score", display=display.none)
plot(rvol, "RVOL", display=display.none)
plot(atrPct, "ATR%", display=display.none)
plot(bookFlag ? 1 : 0, "Book Flag", display=display.none)

// ═══════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════
alertcondition(sigA_long,  title="A Long (HTF pullback)",  message="NEXUS v2 A LONG {{ticker}} @ {{close}}")
alertcondition(sigA_short, title="A Short (HTF pullback)", message="NEXUS v2 A SHORT {{ticker}} @ {{close}}")
alertcondition(sigB_long,  title="B Long (ORB)",           message="NEXUS v2 B LONG ORB {{ticker}} @ {{close}}")
alertcondition(sigB_short, title="B Short (ORB)",          message="NEXUS v2 B SHORT ORB {{ticker}} @ {{close}}")
alertcondition(sigC_long,  title="C Long (VWAP reclaim)",  message="NEXUS v2 C LONG VWAP {{ticker}} @ {{close}}")
alertcondition(sigC_short, title="C Short (VWAP reclaim)", message="NEXUS v2 C SHORT VWAP {{ticker}} @ {{close}}")
alertcondition(sigD_long,  title="D Long (Compression)",   message="NEXUS v2 D LONG COMP {{ticker}} @ {{close}}")
alertcondition(sigD_short, title="D Short (Compression)",  message="NEXUS v2 D SHORT COMP {{ticker}} @ {{close}}")
alertcondition(exitLong,   title="Exit Long",              message="NEXUS v2 EXIT LONG {{ticker}} @ {{close}}")
alertcondition(exitShort,  title="Exit Short",             message="NEXUS v2 EXIT SHORT {{ticker}} @ {{close}}")
alertcondition(scanPass and barOk, title="Scan Pass",      message="NEXUS v2 SCAN PASS {{ticker}}")
